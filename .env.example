# Local Docker Compose secrets and connection strings (LCFM-26).
# Copy this file to `.env` in the repository root and edit values.
# `.env` is gitignored — never commit real passwords.

# SQL Server SA password (must meet MSSQL complexity rules).
MSSQL_SA_PASSWORD=ReplaceWith_Str0ngPassword!

# Next.js reads these to target the existing Catalog and Identity databases.
# Keep the Password= segment in sync with MSSQL_SA_PASSWORD.
# Quote values so shells and Compose keep spaces (User Id=...) intact.
CATALOG_CONNECTION_STRING="Server=sqlserver,1433;Database=Microsoft.eShopOnWeb.CatalogDb;User Id=sa;Password=ReplaceWith_Str0ngPassword!;TrustServerCertificate=True;"
IDENTITY_CONNECTION_STRING="Server=sqlserver,1433;Database=Microsoft.eShopOnWeb.Identity;User Id=sa;Password=ReplaceWith_Str0ngPassword!;TrustServerCertificate=True;"
